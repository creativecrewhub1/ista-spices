# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env files
.env
.env.*
!.env.example

# Local MCP config (contains API keys)
.mcp.json

# Claude Code local tooling (installed skills, session config)
.claude/

# Misc
.cache
.vite
coverage
Thumbs.db

# Supabase CLI local cache
supabase/.temp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Ruflo local secrets and runtime data
.env.local
.env.*.local

# claude-flow / agent-orchestration tooling — local scaffolding, not part of this app
.claude-flow/
.swarm/
.agents/
/CLAUDE.md
skills-lock.json

# TypeScript incremental build state
*.tsbuildinfo

# Playwright verification runs
test-results/
playwright-report/
.playwright/

# Supabase CLI local state beyond the temp cache
supabase/.branches/
supabase/.env

# Scratch and editor leftovers
desktop.ini
*.bak
*.tmp

# Deno lockfile — only ever produced by running a one-off script in
# supabase/functions; the edge function build does not use it.
deno.lock

# Merge and patch leftovers
*.orig
*.rej
*~

# Editor local history / workspace state
.history/
*.code-workspace

# Credentials that must never be committed
*.pem
*.key
*.p12
service-account*.json

# Linter caches
.eslintcache
.oxlintcache

# Vite writes these beside the config while resolving it
vite.config.*.timestamp-*
vitest.config.*.timestamp-*

# Process id files from a dev server left running
*.pid

# Throwaway verification scripts. Browser and API checks get written to the
# repo root while working and deleted after; ignoring them means one that
# outlives its purpose cannot be committed by accident. Config files here are
# .ts, so nothing real matches.
/*.mjs
/*.cjs
/scratch/
